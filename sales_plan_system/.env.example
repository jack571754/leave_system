# ============================================
# 销售计划提报系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ============================================
# Django 核心配置 (必填)
# ============================================

# 密钥: 生产环境必须使用强随机字符串
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-change-me-in-production

# 调试模式: 生产环境必须为 False
DJANGO_DEBUG=False

# 允许的主机: 多个用逗号分隔
# 示例: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 数据库配置 (必填)
# ============================================

# 数据库连接 URL
# SQLite (开发): sqlite:///db.sqlite3
# PostgreSQL: postgres://user:password@host:5432/dbname
# MySQL: mysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///db_new.sqlite3

# 数据库连接池大小 (可选)
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=True

# ============================================
# 安全配置 (生产环境必填)
# ============================================

# SSL/HTTPS 相关
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# 可选配置
# ============================================

# 服务器端口
PORT=8000

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 中国网关支付配置 (如需要)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
